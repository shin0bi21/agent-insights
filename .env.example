# Absolute host paths. Docker mounts both at the same paths inside the app
# container so nested target-repository Docker Compose projects can resolve
# their worktrees through the host Docker daemon.
RAS_REPOSITORY_PATH=/absolute/path/to/repository
RAS_RUNTIME_PATH=/absolute/path/to/repo-automation-score-runtime

RAS_PORT=4173
CODEX_VERSION=0.147.0
