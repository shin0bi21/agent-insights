# Absolute host paths. Docker mounts both at the same paths inside the app
# container so nested target-repository Docker Compose projects can resolve
# their worktrees through the host Docker daemon.
AAS_REPOSITORY_PATH=/absolute/path/to/repository
AAS_RUNTIME_PATH=/absolute/path/to/agent-automation-score-runtime

# Leave this as /dev/null unless the selected, trusted repository launches
# Docker. Docker-enabled runs require /var/run/docker.sock and grant the app
# host-level container control.
AAS_DOCKER_SOCKET_PATH=/dev/null

AAS_PORT=4173
CODEX_VERSION=0.147.0

# Defaults preserve volumes created before the Agent Automation Score rename.
# Override only when intentionally starting with different persistent state.
# AAS_APP_DATA_VOLUME=repo-automation-score_app_data
# AAS_CODEX_STATE_VOLUME=repo-automation-score_codex_state
