      "frontend/README.md"
    ]
  },
  "promptFile": "prompt.md",
  "reasoningEfforts": ["low", "medium", "high"],
  "timeoutMinutes": 90,
  "evaluationTimeoutMinutes": 30,
  "repetitions": 3,
  "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
  "checks": [
    { "id": "diff", "label": "Diff integrity", "points": 5, "command": ["git", "diff", "--check"] },
    { "id": "patterns", "label": "Repository patterns", "points": 5, "command": ["node", "scripts/agents/check-patterns.js", "--changed", "{baseSha}"] },
    { "id": "static", "label": "Static analysis", "points": 10, "command": ["bash", "scripts/tests/test-static.sh"] },
    { "id": "backend", "label": "Focused Tasks backend runner", "points": 15, "command": ["bash", "scripts/tests/backend/run-task-tests.sh"] },
    { "id": "frontend", "label": "Focused Tasks frontend runner", "points": 15, "command": ["bash", "scripts/tests/frontend/run-task-tests.sh"] },
    { "id": "application", "label": "Composed changed-application gate", "points": 10, "command": ["bash", "scripts/tests/test-app.sh", "--changed", "{baseSha}"] }
  ],
  "requirements": [
    { "id": "persistence", "label": "Adds task persistence and generated database types", "points": 4, "files": ["backend/db/migrations/*task*.sql"] },
    { "id": "backend-layers", "label": "Implements layered task API code and focused tests", "points": 7, "files": ["backend/src/routes/*task*.ts", "backend/src/controllers/*task*.ts", "backend/src/services/*task*.ts", "backend/tests/tasks/**/*.test.ts"] },
    { "id": "frontend-layers", "label": "Implements a typed Tasks feature with focused tests", "points": 7, "files": ["frontend/src/pages/Staff/Tasks/**/*.tsx", "frontend/src/pages/Staff/Tasks/**/*.test.tsx"] },
    { "id": "view-parity", "label": "Uses the shared table and resource calendar", "points": 5, "contains": ["Table", "ResourceCalendar"] },
    { "id": "page-controls", "label": "Provides shared header controls and persisted preferences", "points": 4, "contains": ["PageHeader", "ViewMenu", "useUserPreference"] },
    { "id": "workflows", "label": "Implements task and confirmation modal workflows", "points": 4, "contains": ["Modal", "useConfirmModal"] },
    { "id": "time-link", "label": "Links time entries to tasks", "points": 4, "contains": ["taskId", "time"] },
    { "id": "narrow-mutations", "label": "Uses focused status and placement mutations", "points": 5, "contains": ["status", "placement", "patch"] }
  ]
}
